# Server
PORT=3001
UPLOAD_DIR=uploads
LOG_LEVEL=info
# Set to 1 only when serving plain HTTP without a TLS-terminating reverse proxy.
# DISABLE_HSTS=1

# File & disk limits (bytes)
MAX_FILE_SIZE=104857600
MAX_DISK_BYTES=1073741824
MAX_FILES_PER_KEY=5
MAX_URLS_PER_KEY=20

# Session & cleanup lifetimes (ms)
EXPIRE_DELAY_MS=300000
MAX_EXPIRE_MS=3600000
SSE_MAX_DURATION_MS=1800000
SSE_HEARTBEAT_MS=25000
FILE_DELETE_DELAY_MS=60000
UPLOAD_CLEANUP_INTERVAL_MS=3600000

# Concurrency & rate limits (per IP / IPv6 /56 per window; never set to 0 — 0 blocks all requests)
MAX_ACTIVE_KEYS=100
MAX_KEYS_PER_IP=3
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=10
DOWNLOAD_RATE_LIMIT_MAX=20
DELETE_RATE_LIMIT_MAX=20
EVENTS_RATE_LIMIT_MAX=5
STATUS_RATE_LIMIT_MAX=120

# Converter & ZIP limits
# kindling | kindlegen
KINDLE_CONVERTER=kindling
CONVERTER_TIMEOUT_MS=55000
KINDLEGEN_TIMEOUT_MS=100000
# Set to 0 to disable the per-process prlimit --as cap (container mem_limit still applies).
KINDLING_MEMORY_LIMIT_BYTES=402653184
KINDLING_MAX_UNPACKED_BYTES=268435456
MAX_KINDLE_ENTRIES=10000
MAX_CONVERT_UNCOMPRESSED_BYTES=536870912
MAX_ZIP_INDEX_BYTES=4194304

# Optional: Google Books API key for EPUB metadata enrichment
GOOGLE_BOOKS_API_KEY=

# BalkanDownload e-book search integration
# Set to 0 to disable BalkanDownload search and background catalog sync
BALKANDOWNLOAD_ENABLED=1
BALKANDOWNLOAD_DB_PATH=data/balkandownload.sqlite
BALKANDOWNLOAD_SYNC_INTERVAL_MS=86400000
BALKANDOWNLOAD_THREAD_CACHE_TTL_MS=86400000
BALKANDOWNLOAD_MAX_THREAD_PAGES=15
BALKANDOWNLOAD_REQUEST_TIMEOUT_MS=20000
BALKANDOWNLOAD_SEARCH_RATE_LIMIT_MAX=120
BALKANDOWNLOAD_THREAD_RATE_LIMIT_MAX=30
BALKANDOWNLOAD_SYNC_RATE_LIMIT_MAX=3

# Optional: Cloudflare Tunnel (free) for exposing local Docker container on a custom domain
# Uncomment COMPOSE_PROFILES=tunnel and set the token from Cloudflare Zero Trust -> Networks -> Tunnels
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
